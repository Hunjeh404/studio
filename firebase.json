{
  "hosting": [
    {
      "target": "studio",
      "public": "public",
      "ignore": ["firebase.json", "**/.*"],
      "headers": [
        { "source": "**/*.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
        { "source": "index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    },
    {
      "target": "elsa-phonics",
      "public": "phonics/elsa",
      "ignore": ["**/.*"]
    },
    {
      "target": "wordmaze",
      "public": "wordmaze/dist",
      "ignore": ["**/.*"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "animaleague",
      "public": "baseball",
      "ignore": ["**/.*", "**/node_modules/**", "src/**", "tests/**", "scripts/**", "*.json", "*.mjs", "*.md"],
      "headers": [{ "source": "index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
    }
  ]
}
